# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# Content-hashed build output never changes under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and map data change only on a rebuild; a day is plenty.
/images/*
  Cache-Control: public, max-age=86400
/maps/*
  Cache-Control: public, max-age=86400
/routes/*
  Cache-Control: public, max-age=86400
